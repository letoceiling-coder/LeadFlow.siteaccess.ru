{
  "name": "leadflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c teal,slate \"next dev\" \"tsx src/worker.ts\"",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/worker.ts",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.930.0",
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.553.0",
    "next": "^15.5.6",
    "nodemailer": "^7.0.10",
    "prisma": "^6.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

DATABASE_URL=
REDIS_URL=

PARSER_API_BASE_URL=https://parser.rinulik.ru
PARSER_API_KEY=

STUDIO_API_BASE_URL=https://lovable.siteaccess.ru/api/v1
STUDIO_API_KEY=

OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
# HTTP-прокси для OpenRouter. direct — ходить напрямую. Пусто — прокси по умолчанию.
OPENROUTER_PROXY_URL=
# Пусто — модель задачи. Другое значение принимается, только если это одна из трёх: deepseek/deepseek-v4-flash, google/gemma-4-31b-it, z-ai/glm-5.3-flash.
AI_DEFAULT_MODEL=
AGENT_MODEL=

ENCRYPTION_KEY=

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

APP_URL=
AUTH_SECRET=

# Необязательно. Пустые значения означают, что канал не подключён.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER=
SMS_API_ID=
ALLOW_REGISTRATION=
# Обработчик всегда отдельный процесс: npm run worker. Эта переменная только печатает напоминание.
EMBED_WORKER=
